# ============================================================
# Registro unico oggetti smarriti — environment sample
# Copia in .env e popola i valori. NON committare .env.
#   cp .env.example .env
# ============================================================

# ---------- Web server ----------
API_WEB_APIHOST=0.0.0.0:3000
API_WEB_READTIMEOUT=10s
API_WEB_WRITETIMEOUT=60s
API_WEB_SHUTDOWNTIMEOUT=10s

# ---------- SQLite ----------
API_DB_FILENAME=db/lostfound.db

# ---------- Logging ----------
API_LOGGER_LEVEL=info
API_LOGGER_FILE=stdout

# ---------- CORS ----------
# 3000 = UI servita dal binario Go, 5173 = Vite dev server
API_CORS_ALLOWALLORIGINS=false
API_CORS_ALLOWEDORIGINS=http://localhost:3000;http://localhost:5173
API_CORS_ALLOWEDMETHODS=GET;POST;PUT;PATCH;DELETE;OPTIONS
API_CORS_ALLOWEDHEADERS=Accept;Content-Type;Authorization
API_CORS_ALLOWCREDENTIALS=true
API_CORS_MAXAGE=86400

# ---------- Auth / sessions ----------
# Genera i segreti con: openssl rand -hex 32
API_AUTH_SESSION_SECRET=
API_AUTH_PASS_SECRET=
API_AUTH_SESSION_TTL=12h
API_AUTH_PASS_TTL=30m
API_AUTH_COOKIE_NAME=lf_session

# ---------- DeepSeek (orchestrator / LLM) ----------
API_DEEPSEEK_KEY=
API_DEEPSEEK_URL=https://api.deepseek.com
API_DEEPSEEK_MODEL=deepseek-v4.1-flash
API_DEEPSEEK_TIMEOUT=30s
API_DEEPSEEK_MAX_TOOL_ROUNDS=5

# ---------- D3 (structured decision engine) ----------
# Endpoint atteso: <API_D3_URL>/v1/systemone
API_D3_URL=
API_D3_KEY=
API_D3_MODEL=d3
API_D3_TIMEOUT=10s

# ---------- Embeddings (vLLM / Nemotron 3.5 Embed 8B) ----------
# Verificato: il modello restituisce vettori da 4096 dimensioni.
API_EMBEDDINGS_URL=http://www.lucascutigliani.it:8000/v1/embeddings
API_EMBEDDINGS_MODEL=nvidia/Nemotron-3.5-Embed-8B-BF16
API_EMBEDDINGS_KEY=
API_EMBEDDINGS_TIMEOUT=10s
API_EMBEDDINGS_BATCH_SIZE=32

# ---------- Qdrant (vector DB) ----------
# Locale con `go run`: localhost. In Docker Compose il servizio api usa qdrant:6333.
API_QDRANT_URL=http://localhost:6333
API_QDRANT_COLLECTION=items
API_QDRANT_API_KEY=
API_QDRANT_TIMEOUT=5s

# ---------- Storage / uploads ----------
API_STORAGE_DATA_DIR=./data
API_STORAGE_MAX_UPLOAD_MB=8

# ---------- App ----------
API_APP_PUBLIC_URL=http://localhost:3000

# ---------- Custody / legal policy ----------
API_CIVIC_CUSTODY_DAYS=7
API_SENSITIVE_CUSTODY_HOURS=24
API_LEGAL_TERM_DAYS=365

# ---------- PA fees (demo defaults; seeded in DB) ----------
API_PA_DAILY_RATE_CENTS=500
API_PA_FIXED_FEE_CENTS=1000
API_PA_CURRENCY=EUR

# ---------- Payment ----------
# mock | stripe
API_PAYMENT_PROVIDER=mock
API_STRIPE_SECRET_KEY=

# ---------- Demo ----------
API_DEMO_RESET_SECRET=
API_DEMO_MODE=true

# ---------- Feature flags ----------
API_FEATURES_QDRANT=true
API_FEATURES_D3=true
API_FEATURES_DEEPSEEK=true
API_FEATURES_PAYMENT=true

# ---------- Frontend (Vite dev proxy) ----------
VITE_DEV_API_TARGET=http://localhost:3000

# ---------- Cloudflare Tunnel (optional, demo) ----------
CLOUDFLARE_TUNNEL_TOKEN=
